{
  "name": "@local/dsh-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Profile-global hybrid memory and retrieval system for DeepSeek Harness.",
  "main": "plugin.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "exports": {
    ".": "./plugin.js",
    "./client": "./client.js",
    "./service": "./service.js",
    "./package.json": "./package.json"
  }
}
