  "variants": {
    "$comment": "The graphs a user may choose between, each carrying the description the settings UI shows — the copy travels with the pin, so it cannot drift from the file it describes. Digests come from the repository's tree API, where an LFS entry's `oid` is the file's sha256; the already-pinned q8 entry proves that mapping, since its listing digest matches the hash this bundle has verified downloads against from the start. A wrong digest fails loudly at download rather than silently. No note here recommends an option: which one wins depends on the CPU, and the plugin measures rather than asserts.",
    "q8f16": {
      "path": "onnx/model_q8f16.onnx",
      "bytes": 86033585,
      "sha256": "04c658aec1b6008857c2ad10f8c589d4180d0ec427e7e6118ceb487e215c3cd0",
      "label": "q8f16 — smallest (82 MB)",
      "note": "8-bit weights with float16 activations, by the repository's naming. The float16 side wants AVX2 to be worth anything. Measured 2.73 on this host against q8's 2.80 — the smallest download and, in that sweep, marginally the faster of the two."
    },
    "q8": {
      "path": "onnx/model_quantized.onnx",
      "bytes": 92361116,
      "sha256": "fbae9257e1e05ffc727e951ef9b9c98418e6d79f1c9b6b13bd59f5c9028a1478",
      "label": "q8 — the shipped default (88 MB)",
      "note": "Fastest on CPUs with AVX-512 VNNI, where the integer kernels run natively. On a CPU without AVX2 that arithmetic is emulated instead, and this measured 2.80 here — mid-table, with the whole spread across all six types only 17%."
    },
    "uint8f16": {
      "path": "onnx/model_uint8f16.onnx",
      "bytes": 114209226,
      "sha256": "883333e03c597584b532eebea0f8310f25f0c9ade58fe864792c12d969944a9a",
      "label": "uint8f16 — (109 MB)",
      "note": "Unsigned 8-bit weights with float16 activations: the uint8 counterpart of q8f16."
    },
    "uint8": {
      "path": "onnx/model_uint8.onnx",
      "bytes": 177464632,
      "sha256": "6607a397d77b8514065420b7c1e7320117f7aabfdb45ce15f0050c5b0fe75aea",
      "label": "uint8 — (169 MB)",
      "note": "Measured fastest of the six on this host, 2.60 against q8's 2.80, in both workload shapes. Twice the download for about 6%, and the usual argument against uint8 assumes AVX-512 VNNI, which this CPU does not have."
    },
    "fp16": {
      "path": "onnx/model_fp16.onnx",
      "bytes": 163234740,
      "sha256": "ba4527a874b42b21e35f468c10d326fdff3c7fc8cac1f85e9eb6c0dfc35c334a",
      "label": "fp16 — middle (156 MB)",
      "note": "Needs F16C and AVX to pay off. Without them the half-precision values are converted on the fly, which usually costs more than it saves."
    },
    "fp32": {
      "path": "onnx/model.onnx",
      "bytes": 325532232,
      "sha256": "8fbea51ea711f2af382e88c833d9e288c6dc82ce5e98421ea61c058ce21a34cb",
      "label": "fp32 — largest (310 MB)",
      "note": "No special CPU features required. An earlier short-passage measurement here made it the fastest of the three, but at a full 346-token passage it measured 2.92 against q8's 2.80 — so the ordering is shape-dependent, and on this CPU no type is close to real time."
    }
  },
